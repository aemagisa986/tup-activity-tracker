# Copy these into your host's "Environment" settings (Render: service → Environment).
# Never put real values in a file you upload to GitHub.

# PostgreSQL connection string from Neon (Dashboard → Connect). Leave unset to save to data/db.json instead.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# The account with this email becomes the administrator when it registers.
ADMIN_EMAIL=your.name@tup.edu.ph

# Only emails at these domains may register (comma-separated). Remove the line to allow any email.
ALLOWED_EMAIL_DOMAINS=tup.edu.ph
